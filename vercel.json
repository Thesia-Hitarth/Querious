{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/user/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/questions/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/answer/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/notifications/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}