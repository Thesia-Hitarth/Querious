{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/build",
  "env": {
    "CI": "false"
  },
  "rewrites": [
    {
      "source": "/user/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/questions/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/answer/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/notifications/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}